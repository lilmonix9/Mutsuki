# 自编译引擎：Godot + Voxel Tools（C++ 模块）。见决策 0004。
# 改动本文件或 tools/build-engine.sh 会让 CI 重新编译引擎（约 30–60 分钟）。
GODOT_VERSION=4.7.2
GODOT_STATUS=stable
GODOT_COMMIT=ed1daf0bf001b61586d9930840f2f1394092c079
VOXEL_VERSION=1.7
VOXEL_COMMIT=2ac9f5f8a8219bf499314cc0fad54ffc47df908f
# Godot 官方 Linux 工具链（旧 glibc，产物能在较老的发行版上运行）
BUILDROOT_URL=https://github.com/godotengine/buildroot/releases/download/godot-2023.08.x-4/x86_64-godot-linux-gnu_sdk-buildroot.tar.bz2
BUILDROOT_SHA256=b89f173b1f2f2f35f3090bc4efad732f1c0c1c1206e5480cfcb141977010bc94
# Windows 上用 pip 安装的 SCons 版本
SCONS_VERSION=4.11.1
